{
  "name": "www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent-docs": "vitest run --config vitest.agent-docs.config.mts --coverage.enabled=false",
    "analyze": "pnpm generate:docs && ANALYZE=true next build",
    "build": "pnpm generate:docs && next build",
    "dev": "pnpm generate:docs && next dev --turbopack -p 3100",
    "generate:docs": "node --experimental-strip-types scripts/agent-docs.ts",
    "start": "next start -p 3100",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.0",
    "@repo/design-system": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "effect": "3.22.1",
    "geist": "^1.7.2",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "node-html-parser": "9.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@repo/typescript-config": "workspace:*",
    "@types/mdx": "2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/config": "^0.6.0",
    "afdocs": "0.19.0",
    "node-html-markdown": "2.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
