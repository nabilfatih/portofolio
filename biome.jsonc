{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!!repos/effect",
      "!!apps/www/src/routeTree.gen.ts",
      "!!apps/www/src/content/contributions.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      // TanStack Router reads dynamic segments from file names such as work.$slug.tsx.
      "includes": ["apps/www/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  }
}
