{
  "name": "www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#www/*": "./*.ts"
  },
  "scripts": {
    "agent-docs": "vitest run --config vitest.agent-docs.config.mts --coverage.enabled=false",
    "build": "bun run generate:docs && bun run generate:social && vite build && bun scripts/verify-pages.ts",
    "deploy": "alchemy deploy --stage prod",
    "dev": "bun run generate:docs && vite dev",
    "generate:docs": "bun scripts/agent-docs.ts",
    "generate:social": "bun scripts/social-images.ts",
    "plan": "alchemy plan --stage prod",
    "start": "vite preview",
    "test": "vitest run",
    "typecheck": "tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@repo/design-system": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "effect": "4.1.0",
    "mermaid": "11.16.1",
    "node-html-parser": "9.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "takumi-js": "2.10.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "https://pkg.alchemy.run/@alchemy.run/cloudflare/-/7ab6a6e898217421d56affee30688194eb4a9ce22abc21660634c8afe977eebf.tgz",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@mdx-js/rollup": "3.1.1",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/mdx": "2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "afdocs": "0.19.0",
    "alchemy": "https://pkg.alchemy.run/alchemy/-/e7670ec4be7543453ff4dfb68321d9a4a1bb4450a5608fb20731df35d0523bfa.tgz",
    "node-html-markdown": "2.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  }
}
