{
  "extends": "@repo/typescript-config/vite.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": ["**/*.mdx", "**/*.ts", "**/*.tsx", "*.mts"],
  "exclude": ["node_modules", "dist"]
}
